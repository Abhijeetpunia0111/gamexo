# Copy to .env. Local dev only; contains no secrets.

# Where the FastAPI backend is listening. This is a separate frontend hosted
# independently from the admin dashboard, but it talks to the same backend/DB —
# just point this at wherever that backend is deployed.
VITE_API_BASE_URL=http://localhost:8000

# Which academy this counter belongs to. Sent as the X-Tenant-ID header, which
# the API accepts only while ALLOW_TENANT_HEADER=true — in production the tenant
# comes from the host subdomain instead and this value is ignored.
VITE_TENANT_SLUG=xcourt

# UPI VPA the settle-bill QR code pays into. POS-local placeholder for now — there's
# no Settings field for this on the backend yet, so it isn't dashboard-configurable.
VITE_UPI_ID=xcourtsports@upi
